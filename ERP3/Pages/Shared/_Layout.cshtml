@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using ERP3.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP3</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        .nav-link.active {
            font-weight: bold;
            color: #0d6efd !important;
            background-color: #e7f1ff;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
        <div class="container-fluid">
            <a class="navbar-brand" asp-page="/Index">ERP3 Dashboard</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @{
                        string displayName = string.Empty;
                        if (SignInManager.IsSignedIn(User))
                            displayName = Context.Session.GetString("DisplayName") ?? User.Identity?.Name ?? "";
                    }
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item me-2">Xin chào, @displayName</li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Account/Logout" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Đăng xuất</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-primary btn-sm me-2" asp-page="/Account/Login">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-success btn-sm" asp-page="/Account/Register">Đăng ký</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid mt-3">
        <div class="row">
            <aside class="col-md-2 bg-light border-end p-3 vh-100 overflow-auto">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a asp-page="/Index" class="nav-link @(Context.Request.Path == "/" ? "active" : "")">Trang chủ</a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var userRole = UserManager.GetRolesAsync(await UserManager.GetUserAsync(User)).Result.FirstOrDefault() ?? "";

                        if (userRole == "Admin" || userRole == "Manager")
                        {
                            <li class="nav-item">
                                <a asp-page="/Employees/Index" class="nav-link @(Context.Request.Path.StartsWithSegments("/Employees") ? "active" : "")">Nhân viên</a>
                            </li>
                            <li class="nav-item">
                                <a asp-page="/Warehouse/Index" class="nav-link @(Context.Request.Path.StartsWithSegments("/Warehouse") ? "active" : "")">Kho</a>
                            </li>
                            <li class="nav-item">
                                <a asp-page="/AccountingTransactions/Index" class="nav-link @(Context.Request.Path.StartsWithSegments("/AccountingTransactions") ? "active" : "")">Giao dịch</a>
                            </li>
                            <li class="nav-item">
                                <a asp-page="/Reports/FinanceReport" class="nav-link @(Context.Request.Path.StartsWithSegments("/Reports/FinanceReport") ? "active" : "")">Báo cáo tài chính</a>
                            </li>
                            <li class="nav-item">
                                <a asp-page="/Reports/TaxReport" class="nav-link @(Context.Request.Path.StartsWithSegments("/Reports/TaxReport") ? "active" : "")">Báo cáo thuế</a>
                            </li>
                        }
                        else if (userRole == "Staff")
                        {
                            <li class="nav-item">
                                <a asp-page="/Warehouse/Index" class="nav-link @(Context.Request.Path.StartsWithSegments("/Warehouse") ? "active" : "")">Kho</a>
                            </li>
                            <li class="nav-item">
                                <a asp-page="/AccountingTransactions/Index" class="nav-link @(Context.Request.Path.StartsWithSegments("/AccountingTransactions") ? "active" : "")">Giao dịch</a>
                            </li>
                        }
                    }
                </ul>
            </aside>
            <main class="col-md-10">
                @RenderBody()  <!-- ⚠ Đây là nơi form đăng ký sẽ hiển thị khi bạn vào /Account/Register -->
            </main>
        </div>
    </div>

    <footer class="text-center py-3 bg-light mt-3">
        &copy; @DateTime.Now.Year ERP3 - Hệ thống quản lý doanh nghiệp
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

