@page "{id:int}"
@model ERP5.Pages.Admin.FinancialTransactions.DeleteModel
@{
    ViewData["Title"] = "Delete Financial Transaction";
}

<h2>Delete Financial Transaction</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this transaction: <strong>@Model.Transaction.Description</strong>?
</div>

<form method="post">
    <input type="hidden" asp-for="Transaction.Id" />
    <button class="btn btn-danger" type="submit">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
