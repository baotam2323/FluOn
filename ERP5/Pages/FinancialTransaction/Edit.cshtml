@page "{id:int}"
@model ERP5.Pages.Admin.FinancialTransactions.EditModel
@{
    ViewData["Title"] = "Edit Financial Transaction";
}

<h2>Edit Financial Transaction</h2>

<form method="post">
    <input type="hidden" asp-for="Transaction.Id" />

    <div class="mb-3">
        <label asp-for="Transaction.Description" class="form-label"></label>
        <input asp-for="Transaction.Description" class="form-control" />
        <span asp-validation-for="Transaction.Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Transaction.Amount" class="form-label"></label>
        <input asp-for="Transaction.Amount" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Transaction.Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
