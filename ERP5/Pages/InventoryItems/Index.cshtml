@page "/Inventory"
@model ERP5.Pages.InventoryItems.IndexModel
@{
    ViewData["Title"] = "Inventory Management";
}

<h2>@ViewData["Title"]</h2>

<!-- Form thêm mới -->
<h4>Add New Inventory Item</h4>
<form method="post" asp-page-handler="Add">
    <div class="row mb-2">
        <div class="col">
            <input asp-for="NewItem.Name" class="form-control" placeholder="Name" />
        </div>
        <div class="col">
            <input asp-for="NewItem.Description" class="form-control" placeholder="Description" />
        </div>
        <div class="col">
            <input asp-for="NewItem.Unit" class="form-control" placeholder="Unit" />
        </div>
        <div class="col">
            <input asp-for="NewItem.Quantity" type="number" class="form-control" placeholder="Quantity" />
        </div>
        <div class="col">
            <input asp-for="NewItem.UnitPrice" type="number" step="0.01" class="form-control" placeholder="Unit Price" />
        </div>
        <div class="col">
            <input asp-for="NewItem.Location" class="form-control" placeholder="Location" />
        </div>
        <div class="col">
            <button type="submit" class="btn btn-success">Add</button>
        </div>
    </div>
</form>

<hr />

<!-- Bảng hiển thị Inventory -->
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Unit</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Location</th>
            <th>Created At</th>
            <th>Last Updated</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.InventoryItems)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Unit</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.Location</td>
                <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.LastUpdated.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <form method="post" asp-page-handler="Delete" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>

                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editModal-@item.Id">Edit</button>

                    <!-- Modal Edit -->
                    <div class="modal fade" id="editModal-@item.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form method="post" asp-page-handler="Update">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit Item: @item.Name</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <input type="hidden" name="Id" value="@item.Id" />
                                        <div class="mb-2">
                                            <input name="NewItem.Name" value="@item.Name" class="form-control" />
                                        </div>
                                        <div class="mb-2">
                                            <input name="NewItem.Description" value="@item.Description" class="form-control" />
                                        </div>
                                        <div class="mb-2">
                                            <input name="NewItem.Unit" value="@item.Unit" class="form-control" />
                                        </div>
                                        <div class="mb-2">
                                            <input name="NewItem.Quantity" type="number" value="@item.Quantity" class="form-control" />
                                        </div>
                                        <div class="mb-2">
                                            <input name="NewItem.UnitPrice" type="number" step="0.01" value="@item.UnitPrice" class="form-control" />
                                        </div>
                                        <div class="mb-2">
                                            <input name="NewItem.Location" value="@item.Location" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
}
