@page
@model ERP5.Pages.Admin.SalesOrders.IndexModel
@{
    ViewData["Title"] = "Sales Orders";
}

<h2>Sales Orders</h2>

<a asp-page="Create" class="btn btn-primary mb-2">Create New Order</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Order Number</th>
            <th>Order Date</th>
            <th>Customer</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var so in Model.SalesOrders)
        {
            <tr>
                <td>@so.OrderNumber</td>
                <td>@so.OrderDate.ToString("dd/MM/yyyy")</td>
                <td>@so.Customer?.UserName</td>
                <td>@so.TotalAmount.ToString("C")</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@so.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@so.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
