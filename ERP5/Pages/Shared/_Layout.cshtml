<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">ERP5</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <!-- Admin Menu -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown">
                                Admin
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/Admin/Users">Manage Users</a></li>
                                <li><a class="dropdown-item" href="/Admin/ResetInvalidPasswords">Reset Passwords</a></li>
                                <li><a class="dropdown-item" href="/Admin/TokenLogs">Token Logs</a></li>
                                <li><a class="dropdown-item" href="/Admin/ActivityLogs">Activity Logs</a></li>
                            </ul>
                        </li>
                    }

                    <!-- Employee / Logistics Menu -->
                    @if (User.IsInRole("Employee"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="employeeMenu" role="button" data-bs-toggle="dropdown">
                                Logistics
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/Inventory">Inventory</a></li>
                                <li><a class="dropdown-item" href="/PurchaseOrders">Purchase Orders</a></li>
                                <li><a class="dropdown-item" href="/SupplyChain/Import">Import Goods</a></li>
                                <li><a class="dropdown-item" href="/SupplyChain/Export">Export Goods</a></li>
                                <li><a class="dropdown-item" href="/SupplyChain/Storage">Warehouse Storage</a></li>
                                <li><a class="dropdown-item" href="/SupplyChain/Tracking">Shipment Tracking</a></li>
                            </ul>
                        </li>
                    }

                    <!-- User / Token Menu -->
                    @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="tokenMenu" role="button" data-bs-toggle="dropdown">
                                Tokens
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/Tokens/Balance">My Balance</a></li>
                                <li><a class="dropdown-item" href="/Tokens/Buy">Buy Tokens</a></li>
                                <li><a class="dropdown-item" href="/Tokens/History">Transaction History</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <!-- Authentication Links -->
                <ul class="navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Profile">Hello, @User.Identity.Name</a>
                        </li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
