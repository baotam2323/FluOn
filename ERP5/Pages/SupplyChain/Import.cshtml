@page
@model ERP5.Pages.SupplyChain.ImportModel
@{
    ViewData["Title"] = "Import Goods";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <div class="mb-3">
        <label asp-for="ImportItem.Name" class="form-label">Item Name</label>
        <input asp-for="ImportItem.Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ImportItem.Quantity" class="form-label">Quantity</label>
        <input asp-for="ImportItem.Quantity" class="form-control" type="number" />
    </div>
    <div class="mb-3">
        <label asp-for="ImportItem.Unit" class="form-label">Unit</label>
        <input asp-for="ImportItem.Unit" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Import</button>
</form>
