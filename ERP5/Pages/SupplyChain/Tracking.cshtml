@page
@model ERP5.Pages.SupplyChain.TrackingModel
@{
    ViewData["Title"] = "Shipment Tracking";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order Number</th>
            <th>Type</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Shipped At</th>
            <th>Tracking Number</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var shipment in Model.Shipments)
        {
            <tr>
                <td>@shipment.OrderNumber</td>
                <td>@shipment.Type</td>
                <td>@shipment.Status</td>
                <td>@shipment.CreatedAt</td>
                <td>@shipment.ShippedAt?.ToString("g")</td>
                <td>@shipment.TrackingNumber</td>
            </tr>
        }
    </tbody>
</table>
