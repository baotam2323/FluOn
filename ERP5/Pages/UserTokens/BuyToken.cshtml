@page
@model ERP5.Pages.UserTokens.BuyTokenModel
@{
    ViewData["Title"] = "Buy Token";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <div class="mb-3">
        <label>Amount</label>
        <input asp-for="Amount" type="number" class="form-control" min="1" />
    </div>
    <button type="submit" class="btn btn-success">Buy Token</button>
</form>

@if (Model.Message != null)
{
    <div class="alert alert-info mt-3">@Model.Message</div>
}
