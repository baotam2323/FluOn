@page
@model ERP5.Pages.UserTokens.IndexModel
@{
    ViewData["Title"] = "User Tokens";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Token</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>User</th>
            <th>Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var token in Model.UserTokens)
        {
            <tr>
                <td>@token.User?.FullName</td>
                <td>@token.Amount</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@token.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Details" asp-route-id="@token.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="Delete" asp-route-id="@token.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
